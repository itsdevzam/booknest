{
  "name": "pdfx",
  "version": "1.0.0",
  "summary": "Flutter Plugin to render a PDF file.",
  "description": "Flutter Plugin to render a PDF file.\nDownloaded by pub (not CocoaPods).",
  "homepage": "https://github.com/ScerIO/packages.flutter/tree/main/packages/pdfx",
  "license": {
    "type": "MIT",
    "file": "../LICENSE"
  },
  "authors": {
    "Serge Shkurko": "sergeshkurko@outlook.com"
  },
  "source": {
    "path": "."
  },
  "source_files": "pdfx/Sources/**/*.{h,m,swift}",
  "public_header_files": "pdfx/Sources/**/include/**/*.h",
  "platforms": {
    "ios": "13.0",
    "osx": "10.15"
  },
  "ios": {
    "dependencies": {
      "Flutter": []
    },
    "pod_target_xcconfig": {
      "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "i386"
    }
  },
  "osx": {
    "dependencies": {
      "FlutterMacOS": []
    }
  },
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES"
  },
  "swift_versions": "5.0",
  "swift_version": "5.0"
}
