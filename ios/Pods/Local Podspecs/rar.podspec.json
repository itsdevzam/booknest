{
  "name": "rar",
  "version": "0.2.1",
  "summary": "Flutter plugin for handling RAR files on iOS.",
  "description": "A Flutter plugin for extracting and listing RAR archive contents on iOS.\nUses UnrarKit for RAR format support.",
  "homepage": "https://github.com/lkrjangid1/rar",
  "license": {
    "file": "../LICENSE"
  },
  "authors": {
    "Lokesh Jangid": "lkrjangid@gmail.com"
  },
  "source": {
    "path": "."
  },
  "source_files": "Classes/**/*",
  "dependencies": {
    "Flutter": [],
    "UnrarKit": [
      "~> 2.9"
    ]
  },
  "platforms": {
    "ios": "12.0"
  },
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES",
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "i386"
  },
  "swift_versions": "5.0",
  "swift_version": "5.0"
}
